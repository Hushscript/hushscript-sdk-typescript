{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/generate.mjs",
    "scripts/run-examples.mjs",
    "scripts/check-publish-files.mjs",
    "scripts/examples-register.mjs",
    "smoke/smoke.ts",

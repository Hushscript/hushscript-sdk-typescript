{
  "name": "@hushscript/sdk",
  "version": "1.0.1",
  "description": "Official TypeScript SDK for the Hushscript transcription API.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Hushscript/hushscript-sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hushscript/hushscript-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/Hushscript/hushscript-sdk-typescript/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "config": {
    "conformanceRef": "v1.0.0"
  },
  "scripts": {
    "build": "tsup",
    "conformance": "node --disable-warning=ExperimentalWarning conformance/runner.ts"
  },
  "dependencies": {
    "music-metadata": "^12.2.3",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-regexp": "3.3.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "knip": "6.42.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-floor": "npm:typescript@5.5.4",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
